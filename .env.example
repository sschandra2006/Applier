# ==========================================
# Applier 3.0 Master Environment Template
# ==========================================
#
# Applier 3.0 uses two primary backend services:
# 1. Backend Service (Node.js/Express) -> f:/Applier/backend/.env
# 2. AI Microservice (Python/FastAPI) -> f:/Applier/ai-service/.env
#
# Refer to the dedicated service templates for full variable breakdowns:
# - backend/.env.example
# - ai-service/.env.example
#
# Quick Reference:
# ----------------
# BACKEND:
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/applier
FIREBASE_PROJECT_ID=applier-example-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-sample@applier-example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_here
DOCUMENT_ENCRYPTION_KEY=replace_with_a_32_byte_aes_gcm_master_encryption_key_here
PYTHON_API_URL=http://127.0.0.1:8000/api/v1/ai/execute
USE_IN_MEMORY_QUEUE=true

# AI SERVICE:
LLM_PROVIDER=huggingface
HF_TOKEN=hf_your_huggingface_access_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
