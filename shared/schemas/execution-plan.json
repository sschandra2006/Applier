{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://applier.ai/schemas/execution-plan.json",
  "title": "ExecutionPlan",
  "description": "Full ordered Playwright automation plan generated by ExecutionPlanner.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "planId": {
      "type": "string"
    },
    "targetUrl": {
      "type": "string"
    },
    "totalSteps": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "https://applier.ai/schemas/execution-step.json"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.85
    },
    "notes": {
      "type": ["string", "null"]
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": ["schemaVersion", "targetUrl", "steps"],
  "additionalProperties": true
}
