{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://applier.ai/schemas/applicant-knowledge-graph.json",
  "title": "ApplicantKnowledgeGraph",
  "description": "Canonical representation of the applicant knowledge graph as the authoritative source of truth.",
  "type": "object",
  "$defs": {
    "SourceType": {
      "type": "string",
      "enum": [
        "PROFILE",
        "DOCUMENT",
        "USER_INPUT",
        "PREVIOUS_APPLICATION",
        "SYSTEM_DERIVED"
      ]
    },
    "VerificationStatus": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "CONFIRMATION_REQUIRED",
        "CONFLICT"
      ]
    },
    "KnowledgeNode": {
      "type": "object",
      "properties": {
        "value": {
          "description": "The current atomic value of this knowledge property."
        },
        "source": {
          "$ref": "#/$defs/SourceType"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "verificationStatus": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "updatedAt": {
          "type": "string"
        },
        "evidence": {
          "type": "string",
          "description": "Provenance detail, document reference, or extraction note."
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {},
              "source": { "$ref": "#/$defs/SourceType" },
              "confidence": { "type": "number" },
              "timestamp": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      },
      "required": ["value", "source", "confidence", "verificationStatus", "updatedAt"],
      "additionalProperties": true
    },
    "FieldConflict": {
      "type": "object",
      "properties": {
        "conflictId": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Dot-notated graph path, e.g. 'identity.dateOfBirth'."
        },
        "existingValue": {
          "type": "object",
          "properties": {
            "value": {},
            "source": { "$ref": "#/$defs/SourceType" },
            "evidence": { "type": "string" },
            "confidence": { "type": "number" }
          },
          "required": ["value", "source"]
        },
        "conflictingValue": {
          "type": "object",
          "properties": {
            "value": {},
            "source": { "$ref": "#/$defs/SourceType" },
            "evidence": { "type": "string" },
            "confidence": { "type": "number" }
          },
          "required": ["value", "source"]
        },
        "status": {
          "type": "string",
          "enum": ["UNRESOLVED", "RESOLVED"],
          "default": "UNRESOLVED"
        },
        "reason": {
          "type": "string",
          "default": "FIELD_CONFLICT"
        },
        "detectedAt": {
          "type": "string"
        },
        "resolvedAt": {
          "type": "string"
        },
        "resolution": {
          "type": "object",
          "properties": {
            "selectedSource": { "type": "string" },
            "selectedValue": {},
            "resolvedBy": { "type": "string" }
          }
        }
      },
      "required": ["conflictId", "path", "existingValue", "conflictingValue", "status", "reason", "detectedAt"],
      "additionalProperties": true
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "applicantId": {
      "type": "string",
      "description": "Unique identifier of the applicant."
    },
    "userId": {
      "type": "string",
      "description": "Identifier of the associated user account."
    },
    "identity": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeNode"
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeNode"
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeNode"
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeNode"
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeNode"
      }
    },
    "financial": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeNode"
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeNode"
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/KnowledgeNode"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FieldConflict"
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "integer", "default": 1 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "totalFields": { "type": "integer" },
        "verifiedFields": { "type": "integer" },
        "conflictCount": { "type": "integer" }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "applicantId",
    "userId",
    "identity",
    "contact",
    "address",
    "education",
    "family",
    "financial",
    "preferences",
    "documents"
  ],
  "additionalProperties": true
}
