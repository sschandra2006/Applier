# =============================================
# Applier 3.0 Python AI Service Environment
# =============================================

PROJECT_NAME="Applier AI Service"

# LLM Provider Configuration ("huggingface", "openai", "local", "mock")
LLM_PROVIDER=huggingface

# API Credentials (leave blank if operating offline or using local models)
HF_TOKEN=hf_your_huggingface_access_token_here
LLM_API_KEY=

# Model Endpoints & Default Models
LLM_BASE_URL=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct

# Embeddings Model (SentenceTransformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Inference Limits & Timeouts (seconds)
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Allowed CORS Origins (comma-separated list of allowed callers)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Backend Node API URL (internal service communication)
NODE_API_URL=http://127.0.0.1:5000/api/v1
