# ==========================================
# Applier 3.0 Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB 7.0+)
MONGO_URI=mongodb://127.0.0.1:27017/applier

# Firebase Admin SDK Configuration
# Required for user authentication, verification tokens, and profile ownership
FIREBASE_PROJECT_ID=applier-example-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-sample@applier-example-project.iam.gserviceaccount.com
# Format: Single-line string with escaped newlines (\n) or multi-line PEM block
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=applier-example-project.appspot.com

# Python AI Microservice Endpoint
PYTHON_API_URL=http://127.0.0.1:8000/api/v1/ai/execute

# Security & Cryptography
# JWT secret for Chrome Extension and REST API token signing (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_here
# Master AES-256-GCM encryption key for encrypting resume PDFs and profile data at rest
DOCUMENT_ENCRYPTION_KEY=replace_with_a_32_byte_aes_gcm_master_encryption_key_here

# Redis Queue & Rate Limiter Configuration (Optional - in-memory fallback enabled by default)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
USE_IN_MEMORY_QUEUE=true

# Antivirus Integration (Optional ClamAV daemon)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# CORS Allowed Origins (Comma-separated, including Chrome Extension ID)
CORS_ORIGIN=chrome-extension://YOUR_EXTENSION_ID_HERE,http://localhost:5000,http://127.0.0.1:5000
